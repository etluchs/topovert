# mkgmap line rules for the topovert Swiss style.
#
# Each rule assigns the Garmin line type (0xNN) and the resolution at which the
# line first appears (smaller = visible when zoomed further out; must be one of
# the resolutions declared in `options`: 16/18/20/22/24). Custom colours/widths
# for the topo-relevant types live in topovert_typ.txt; types left to Garmin
# defaults (the road classes) still render sensibly without it.
#
# The OSM tags below are exactly what src/topovert/vector.py emits.

# --- Roads (road_class/road_speed feed mkgmap address search & routing) ------
highway=motorway      [0x01 road_class=4 road_speed=7 resolution 16]
highway=motorway_link [0x09 road_class=3 road_speed=2 resolution 18]
highway=trunk         [0x02 road_class=4 road_speed=6 resolution 16]
highway=primary       [0x03 road_class=3 road_speed=5 resolution 18]
highway=secondary     [0x04 road_class=2 road_speed=4 resolution 18]
highway=tertiary      [0x05 road_class=1 road_speed=3 resolution 20]
highway=unclassified  [0x06 road_class=0 road_speed=3 resolution 20]
highway=residential   [0x06 road_class=0 road_speed=2 resolution 22]
highway=service       [0x07 road_class=0 road_speed=2 resolution 22]
highway=road          [0x06 road_class=0 road_speed=2 resolution 22]
highway=track         [0x0a road_class=0 road_speed=1 resolution 22]
highway=path          [0x16 road_class=0 road_speed=0 resolution 24]

# --- Railways & aerialways ---------------------------------------------------
railway=narrow_gauge  [0x14 resolution 20]
railway=*             [0x14 resolution 18]
aerialway=*           [0x15 resolution 20]

# --- Watercourses ------------------------------------------------------------
waterway=river        [0x1f resolution 18]
waterway=canal        [0x1e resolution 20]
waterway=stream       [0x18 resolution 22]

# --- Ferries & barriers ------------------------------------------------------
route=ferry           [0x1b resolution 18]
barrier=wall          [0x1d resolution 24]
